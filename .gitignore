# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc

# Local database and uploads (never commit lead data)
data/

# Generated outreach files (never commit lead data)
exports/

# Real lead scrapes stay local. Only the sample file is tracked.
sample_data/*
!sample_data/sample_leads.csv

# Copywriter skill source stays local while this repo is public.
# It holds sales tactics and objection scripts a prospect should not find.
# If you make the repo private, remove this line and commit the folder.
skill/

# Streamlit secrets stay local; config.toml is committed.
.streamlit/secrets.toml

# Local secrets (Supabase keys for the planner sync). Never commit.
config.local.yaml

# Live tenant business data stays local while this repo is public.
# It holds pricing strategy, target customer, and sales lines.
# The example tenant is committed as the template.
tenants/*
!tenants/example/
!tenants/example/**
